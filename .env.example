# Convexity — copy to .env and edit. Nothing here is required; every value has
# a working default and the app runs fully without any of them.

# --- the AI volatility read ------------------------------------------------
# Without a key the read is unavailable and everything else works normally.
ANTHROPIC_API_KEY=

# --- market data -----------------------------------------------------------
# yfinance | fake | none
#   yfinance  Yahoo Finance. No signup, no key. Unofficial and rate-limited
#             per IP, so treat it as temporary.
#   fake      A simulated chain. No network. Useful offline.
#   none      Manual entry only, exactly as the app shipped.
CONVEXITY_MARKET_PROVIDER=yfinance

# Massive (formerly Polygon.io) — not yet implemented. Server-side only; this
# value must never be sent to the browser.
CONVEXITY_MASSIVE_API_KEY=

# Cache lifetimes in seconds. These are the main defence against rate limiting,
# and they are per-provider concerns — Massive's limits are nothing like
# Yahoo's, so raise the chain TTL when its data is 15 minutes delayed anyway.
CONVEXITY_MARKET_TTL_SEARCH=86400
CONVEXITY_MARKET_TTL_EXPIRATIONS=21600
CONVEXITY_MARKET_TTL_CHAIN=60
CONVEXITY_MARKET_TTL_NEGATIVE=3600
CONVEXITY_MARKET_TTL_RATE=43200

# --- the risk-free rate ----------------------------------------------------
# ^IRX is the 13-week Treasury bill, quoted as a discount yield in percent and
# converted to a continuously compounded rate before it reaches the models.
CONVEXITY_RISK_FREE_SYMBOL=^IRX
CONVEXITY_RISK_FREE_FALLBACK=0.04
